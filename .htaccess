<IfModule mod_rewrite.c>
    RewriteEngine On

    # Folder internal tidak boleh diakses langsung bila document root = root proyek.
    RewriteRule ^(app|config|sessions|storage|backups|vendor)(/|$) - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(sql|log|template|ini|bak|sh|md)$">
    Require all denied
</FilesMatch>

Options -Indexes
