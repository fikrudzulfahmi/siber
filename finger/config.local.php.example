    'ping_token' => 'GANTI-DENGAN-TOKEN-ACAK',

    // --- token opsional kalau pull.php dipanggil dari luar localhost ---
    'pull_token' => '',

    // --- opsional: samakan dengan API_DEVICE_KEY di hosting bila diisi ---
